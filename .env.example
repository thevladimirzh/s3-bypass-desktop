# Development-only environment template. Copy to .env and fill in locally.
# NEVER commit real values: .env is gitignored (BRIEF §7).
# Runtime S3 credentials are stored in the OS keychain via safeStorage (M1),
# not in .env — this file exists for local development overrides only.

# Override path to the core binary (defaults to the bundled binary in M2):
CORE_BINARY_PATH=

# S3 transport endpoint (placeholder — real credentials live in the keychain):
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
