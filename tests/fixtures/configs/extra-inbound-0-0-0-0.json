{
  "log": {
    "loglevel": "info"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      }
    },
    {
      "tag": "tproxy-in",
      "listen": "0.0.0.0",
      "port": 18080,
      "protocol": "dokodemo-door",
      "settings": {
        "followRedirect": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "fedarisha",
      "settings": {
        "storage": {
          "type": "s3",
          "bucket": "example-bucket",
          "endpoint": "https://s3.example.com",
          "region": "us-east-1",
          "prefix": "profiles/vlt-alpha",
          "sessionsDir": "sessions",
          "accessKey": "EXAMPLEACCESSKEYID01",
          "secretKey": "EXAMPLESECRETKEY0123456789",
          "sessionToken": "EXAMPLESESSIONTOKEN0001",
          "bucketPassword": "example-bucket-password"
        },
        "tuning": {
          "idleTimeoutSec": 300,
          "pollIntervalMs": 100,
          "writeIntervalMs": 20,
          "maxFileSizeBytes": 2097152
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {}
    }
  ]
}
