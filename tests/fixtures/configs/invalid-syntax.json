{
  "inbounds": [
    {
      // "listen": "0.0.0.0",
      "tag": "socks-in",
      "port": 10808,
      "protocol": "socks",
      "settings": { "auth": "noauth", "udp": true }
    }
  ],
  "log": { "loglevel": "info" },
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "fedarisha",
      "settings": {
        "storage": {
          "type": "s3",
          "bucket": "example-bucket",
          "endpoint": "https://s3.example.com",
          "region": "us-east-1",
          "prefix": "profiles/vlt-alpha",
          "sessionsDir": "sessions",
          "accessKey": "EXAMPLEACCESSKEYID01",
          "secretKey": "EXAMPLESECRETKEY0123456789"
        },
        "tuning": {
          "idleTimeoutSec": 300,
          "pollIntervalMs": 100,
          "writeIntervalMs": 20,
          "maxFileSizeBytes": 2097152
        }
      }
    },
    { "tag": "direct", "protocol": "freedom", "settings": {} }
  ]
}
